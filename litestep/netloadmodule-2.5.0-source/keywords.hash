
# This file specifies keyword mappings.
#
# It is turned into a static hash table by makehash
# in a custom build step.  This allows us to do a
# switch based on a string token rather than a long
# sequence of string compares.
#
# Generates: keywords.h, keywords.cpp

in .cpp #include "NetLoadModule.h"

in .h #define BATCH_BAD_TOKEN       0
in .h #define BATCH_BEGIN			1
in .h #define BATCH_END				2

table BatchKeywords int
{
	begin			BATCH_BEGIN
	end				BATCH_END
}

in .h #define SITE_WEIGHT			1
in .h #define SITE_ORDER			2

table SiteOptionKeywords int
{
	weight			SITE_WEIGHT
	order			SITE_ORDER
}

in .h #define MODULE_LOAD_SPECIFIED 0x10000000

table ModuleOptionKeywords int
{
	threaded		MODULE_THREADED
	nopump			MODULE_NOTPUMPED
	load			MODULE_LOAD_SPECIFIED
}

in .h #define IFTEST_BAD_TOKEN 0
in .h #define IFTEST_NOT       1
in .h #define IFTEST_LOADED    2
in .h #define IFTEST_INSTALLED 3
in .h #define IFTEST_HASALIAS  4
in .h #define IFTEST_THREADED  5

table IfTestKeywords int
{
	not				IFTEST_NOT
	loaded			IFTEST_LOADED
	installed		IFTEST_INSTALLED
	hasalias		IFTEST_HASALIAS
	threaded		IFTEST_THREADED
}

in all #ifndef NO_SCRIPTING

# a different major version will require a new parser
in .h #define SCRIPT_MAJOR_VERSION	1
# a lower minor version can be read by the same parser
# a higher minor version will require a new one
in .h #define SCRIPT_MINOR_VERSION	0

in .h #define SCRIPT_SIGNATURE		1
in .h #define SCRIPT_INSTALL		2
in .h #define SCRIPT_MODULE			3
in .h #define SCRIPT_DOCS			4
in .h #define SCRIPT_FILE			5
in .h #define SCRIPT_LOAD			6
in .h #define SCRIPT_OPTION			7
in .h #define SCRIPT_NORENAME		8
in .h #define SCRIPT_UNKNOWN		1000
in .h #define SCRIPT_EOL			1001
in .h #define SCRIPT_EOF			1002
in .h #define SCRIPT_OPEN			1003
in .h #define SCRIPT_CLOSE			1004

table InstallKeywords int
{
	netloadmodule	SCRIPT_SIGNATURE
	module			SCRIPT_MODULE
	docs			SCRIPT_DOCS
	install			SCRIPT_INSTALL
	file			SCRIPT_FILE
	load			SCRIPT_LOAD
	option			SCRIPT_OPTION
	norename		SCRIPT_NORENAME
	{				SCRIPT_OPEN
	}				SCRIPT_CLOSE
}

in all #endif  // NO_SCRIPTING
