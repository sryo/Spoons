OrbButtonSSText					"$App5Name$"
OrbButtonSSX					$UIButtonSize$
OrbButtonSSY					$UIButtonSize*2$
OrbButtonSSWidth				$UIButtonSize$
OrbButtonSSHeight				$UIButtonSize$
OrbButtonSSColor				transparent
OrbButtonSSParent				Orb
OrbButtonSSHoverColor			$OrbButtonHoverColor$
OrbButtonSSCornerRadiusX		$OrbButtonCornerRadius$
OrbButtonSSCornerRadiusY		$OrbButtonCornerRadius$
