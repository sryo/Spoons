*nLabel							OrbButtonSE
*OrbButtonSEOn					LeftClickUp .none "$App6Path$"
OrbButtonSEText					"$App6Name$"
OrbButtonSEX					$UIButtonSize-UIButtonSize/4*3+1$
OrbButtonSEY					$UIButtonSize+UIButtonSize/4*3-1$
