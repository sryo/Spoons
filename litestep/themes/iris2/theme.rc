OTSMajorVersion			2
OTSMinorVersion			0

ThemeName				"iris2"
ThemeVersion			"20150307"
ThemeAuthor				"sryo"

nModulesRevId			0.7

;	load modules
;*NetLoadModule			MultiMonitor-1.2
*NetLoadModule			nCore-$nModulesRevId$
*NetLoadModule			nDesk-$nModulesRevId$
*NetLoadModule			nLabel-$nModulesRevId$
*NetLoadModule			nClock-$nModulesRevId$
*NetLoadModule			nPopup-$nModulesRevId$
;*NetLoadModule			nTray-$nModulesRevId$
If Win64
*NetLoadModule			tasks-0.96.1-x64
Else
*NetLoadModule			tasks-0.96.1
EndIf
*NetLoadModule			nTask-$nModulesRevId$
*NetLoadModule			mzscript-1.0.4
*NetLoadModule			anykey-1.0

NetLoadModuleOnLoad		!AutoRun
*mzVarFile				"$ThemeDir$vars.mz"
include					"$ThemeDir$vars.mz"
include					"$ThemeDir$bangs.mz"
include					"$ThemeDir$launcher.rc"

;	define evars
QuickLaunchPath		"$QuickLaunch$User Pinned\TaskBar\"
ResolutionX
ResolutionY
App1Name	0
App1Path	0
App2Name	0
App2Path	0
App3Name	0
App3Path	0
App4Name	0
App4Path	0
App5Name	0
App5Path	0
App6Name	0
App6Path	0
App7Name	0
App7Path	0
App8Name	0
App8Path	0

If App1Name = 0
OrbButtonNNHidden	true
EndIf
If App2Name = 0
OrbButtonNWHidden	true
EndIf
If App3Name = 0
OrbButtonWWHidden	true
EndIf
If App4Name = 0
OrbButtonSWHidden	true
EndIf
If App5Name = 0
OrbButtonSSHidden	true
EndIf
If App6Name = 0
OrbButtonSEHidden	true
EndIf
If App7Name = 0
OrbButtonEEHidden	true
EndIf
If App8Name = 0
OrbButtonNEHidden	true
EndIf
;	nDesk
nDeskWorkArea	"0,0,0,0"
*nDeskOn		RightClickUp	.none	!Exec !PopUp %#%{mousex}-nPopupMaxWidth/2%# %#%{mousey}-OrbHeight/2%#
*nDeskOn		MiddleClickDown	.none	!OrbCenter


;	HotKeys
AnyKeyLWinKey	!OrbCenter
AnyKeyNoWarn


;	UI Colors
UIAlpha			99
UIPrimaryColor	33495f
UIAccentColor	00bd9c
UITextColor		ffffff

;	UI Fonts
UIFontSize		14
UIFont			"Dosis"
UIGlyphs		"Material-Design-Iconic-Font"

;	UI Dimensions
UISize			96
UIButtonSize	$UISize/3$
UIIconSize		$UIButtonSize/2$
UICornerRadius	3


;	Orb
*nClock							Orb
*OrbOn							RightClickUp .none !PopUp

OrbAlwaysOnTop					true
OrbWidth						$UISize$
OrbHeight						$UISize$
OrbBrushType					RadialGradient
OrbGradientColors				"#00$UIPrimaryColor$	#00$UIPrimaryColor$	#$UIAlpha$$UIPrimaryColor$	#$UIAlpha$$UIPrimaryColor$	#00$UIPrimaryColor$	#00$UIPrimaryColor$"
OrbGradientStops				"0 						0.1666666666666666	0.166666666666667			0.499						0.5					1"
OrbGradientCenterX				$UISize/2$
OrbGradientCenterY				$UISize/2$
OrbGradientRadiusX				$UISize$
OrbGradientRadiusY				$UISize$
OrbTextAntiAliasMode			GrayScale

;	OrbHourHand
OrbHourHandBrushType			RadialGradient
OrbHourHandGradientColors		"#ff$UIAccentColor$	#00$UIAccentColor$	#00$UIAccentColor$"
OrbHourHandGradientStops		"0.499				0.5					1"
OrbHourHandGradientCenterX		24
OrbHourHandGradientCenterY		8
OrbHourHandGradientRadiusX		8
OrbHourHandGradientRadiusY		8
OrbHourHandLength				$OrbGradientRadiusX$
OrbHourHandThickness			16
OrbHourHandSmoothMovement		false

;	OrbMinuteHand
OrbMinuteHandBrushType			RadialGradient
OrbMinuteHandGradientColors		"#ff$UIAccentColor$	#00$UIAccentColor$	#00$UIAccentColor$"
OrbMinuteHandGradientStops		"0.499		0.5			1"
OrbMinuteHandGradientCenterX	41
OrbMinuteHandGradientCenterY	8
OrbMinuteHandGradientRadiusX	4
OrbMinuteHandGradientRadiusY	4
OrbMinuteHandLength				$OrbGradientRadiusX$
OrbMinuteHandThickness			16
OrbMinuteHandSmoothMovement		false

;	OrbSecondHand
OrbSecondHandColor			transparent


;	OrbButton
OrbButtonCornerRadius 			$nTasksButtonWidth/2$
OrbButtonHoverColor				#ff$UIAccentColor$

*nLabel							OrbButtonNN
*OrbButtonNNOn					LeftClickUp .none "$App1Path$"
OrbButtonNNText					"$App1Name$"
OrbButtonNNX					$UIButtonSize$
OrbButtonNNY					0
OrbButtonNNWidth				$UIButtonSize$
OrbButtonNNHeight				$UIButtonSize$
OrbButtonNNColor				transparent
OrbButtonNNParent				Orb
OrbButtonNNHoverColor			$OrbButtonHoverColor$
OrbButtonNNCornerRadiusX		$OrbButtonCornerRadius$
OrbButtonNNCornerRadiusY		$OrbButtonCornerRadius$
OrbButtonNNTextAlign			Center
OrbButtonNNTextVerticalAlign	Middle
OrbButtonNNFont					$UIFont$
OrbButtonNNFontColor			#ff$UIPrimaryColor$
OrbButtonNNFontWeight			Bold

