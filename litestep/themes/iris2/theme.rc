;	OrbButtonClose
*nLabel							OrbButtonPopup
*OrbButtonPopupOn				LeftClickUp .none !PopUp
*OrbButtonPopupOn				RightClickUp .none !TrayPopUp
OrbButtonPopupX					$UIButtonSize$
OrbButtonPopupY					$UIButtonSize$
OrbButtonPopupWidth				$UIButtonSize$
OrbButtonPopupHeight			$UIButtonSize$
OrbButtonPopupColor				transparent
OrbButtonPopupFontColor			transparent
OrbButtonPopupParent			Orb
OrbButtonPopupCornerRadiusX		$OrbButtonCornerRadius$
OrbButtonPopupCornerRadiusY		$OrbButtonCornerRadius$
OrbButtonPopupText				"W"
OrbButtonPopupTextAlign			Center
OrbButtonPopupTextVerticalAlign	Middle
OrbButtonPopupFont				"Marlett"

OrbButtonPopupHoverColor		$OrbButtonHoverColor$
OrbButtonPopupHoverFontColor	#ff$UIPrimaryColor$

; nTasks
*nTaskbar							nTasks
nTasksAlwaysOnTop					True
nTasksColor							transparent
nTasksX								$OrbX+OrbWidth+nTasksColumnSpacing$
nTasksY								$OrbY+OrbHeight/3$
nTasksWidth							$UIButtonSize$
nTasksHeight						$UIButtonSize$
nTasksColumnSpacing					$UICornerRadius$

;	nTasksThumbnail
nTasksThumbnailColor				#$UIAlpha$$UIPrimaryColor$ ;$nPopupColor$
nTasksThumbnailSizeToButton			False
nTasksThumbnailDistanceFromButton	$nTasksColumnSpacing$
nTasksThumbnailOutlineColor			$nPopupOutlineColor$
nTasksThumbnailOutlineWidth			$nPopupOutlineWidth$
nTasksThumbnailAnimate				True
nTasksThumbnailCornerRadiusX		$nPopupCornerRadiusX$
nTasksThumbnailCornerRadiusY		$nPopupCornerRadiusY$

;	nTasksButton
nTasksButtonWidth					$UIButtonSize$
nTasksButtonHeight					$UIButtonSize$
nTasksButtonColor					#$UIAlpha$$UIPrimaryColor$
nTasksButtonCornerRadiusX			$UIButtonSize/2$
nTasksButtonCornerRadiusY			$UIButtonSize$
nTasksButtonIconSize				$UIIconSize$
nTasksButtonIconX					$(nTasksButtonWidth-nTasksButtonIconSize)/2$
nTasksButtonIconY					$(nTasksButtonHeight-nTasksButtonIconSize)/2$

nTasksButtonHoverColor				#ff$UIAccentColor$
nTasksButtonActiveColor				#ff$UIAccentColor$
nTasksButtonFlashingColor			#ff$UIAccentColor$
nTasksButtonMinimizedIconY			$nTasksButtonHeight/2$


TasksStartHidden	true
TasksOnAdd			!TasksAdd
TasksOnDel			!TasksDel

;	nPopup
nPopupColor				#$UIAlpha$$UIPrimaryColor$
nPopupMaxWidth			160
nPopupTextAntiAliasMode	GrayScale
nPopupChildOffsetX		$-nPopupOutlineWidth$
nPopupChildOffsetY		0
nPopupPaddingLeft		$nPopupOutlineWidth$
nPopupPaddingRight		$nPopupOutlineWidth$
nPopupPaddingTop		$nPopupOutlineWidth$
nPopupPaddingBottom		$nPopupOutlineWidth$
nPopupOutlineColor		#ff$UIPrimaryColor$
nPopupOutlineWidth		$UICornerRadius$
nPopupCornerRadiusX		$UICornerRadius$
nPopupCornerRadiusY		$UICornerRadius$


;	nPopupItem
nPopupItemColor						Transparent
nPopupItemFontColor					#ff$UITextColor$
nPopupItemFontSize					$UIFontSize$
nPopupItemFont						$UIFont$
nPopupItemTextOffsetRight			$UIButtonSize$
nPopupItemTextAlign					Right
nPopupItemHeight					$UIButtonSize$
nPopupItemIconSize					$UIIconSize$
nPopupItemIconX						$nPopupMaxWidth+UIIconSize$
nPopupItemIconY						$(UIButtonSize-UIIconSize)/2$
nPopupItemSpacing					0

;	nPopupItemHover
nPopupItemHoverFontColor			#ff$UIPrimaryColor$
nPopupItemHoverColor				#ff$UIAccentColor$
nPopupItemHoverCornerRadiusX		$UICornerRadius$
nPopupItemHoverCornerRadiusY		$UICornerRadius$

;	nPopupFolderItem
nPopupFolderItemGroup				nPopupItem
nPopupFolderItemIconSize			0
nPopupFolderItemFontColor			#ff$UIAccentColor$
nPopupFolderItemFont				"Dosis"
nPopupFolderItemFontWeight			Bold

;	nPopupFolderItemOpen
nPopupFolderItemOpenFontColor		#ff$UIPrimaryColor$
nPopupFolderItemOpenBrushType		RadialGradient
nPopupFolderItemOpenGradientColors	"#ff$UIPrimaryColor$ #ff$UIPrimaryColor$ #ff$UIAccentColor$ #ff$UIAccentColor$"
nPopupFolderItemOpenGradientStops	"0 0.499 0.5 1"
nPopupFolderItemOpenGradientCenterX	$nPopupMaxWidth+nPopupFolderItemOpenGradientRadiusX/4*3$
nPopupFolderItemOpenGradientCenterY	$nPopupItemHeight/2$
nPopupFolderItemOpenGradientRadiusX	96
nPopupFolderItemOpenGradientRadiusY	16
nPopupFolderItemOpenCornerRadiusX	$UICornerRadius$
nPopupFolderItemOpenCornerRadiusY	$UICornerRadius$

nPopupFolderItemHoverGroup			nPopupFolderItemOpen

;	nPopupSeparatorItem
nPopupSeparatorItemColor			$nPopupOutlineColor$
nPopupSeparatorItemHeight			$UICornerRadius$