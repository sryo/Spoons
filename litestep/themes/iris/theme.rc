OTSMajorVersion			2
OTSMinorVersion			0

ThemeName			"iris"
ThemeVersion			"0.1"
ThemeAuthor			"sryo"
*LoadFont			"$ThemeDir$assets/fonts/OpenSans-Light.ttf"

;load modules
*NetLoadModule			jdesk-0.73
*NetLoadModule			xPaintClass-1.0
*NetLoadModule			xStatsClass-1.1.5
*NetLoadModule			xlabel-4.3				;threading triggers false-drags
*NetLoadModule			xtaskbar-2.3.4
*NetLoadModule			xpopup-2.1				;threading triggers false-drags
*NetLoadModule			lsxcommand-2.0.2			;threading causes trouble with popup/command hide/show on drag
*NetLoadModule			xspeak-0.1		threaded	;disable threaded if using onhover
*NetLoadModule			alias-0.2
*NetLoadModule			comdlgls-0.7				;threading unsupported
*NetLoadModule			xtextedit-0.6
*NetLoadModule			mouse-0.21


LSDisableTrayService		true

LSImageFolder			"$ThemeDir$res\drawable\"
include				"$ThemeDir$res\values\paths.rc"
include				"$ThemeDir$res\values\bools.rc"
NetLoadModuleOnLoad		!PopupLoadCFG "*Popup" "$ThemeDir$res\menu\main.rc"

;set the work area
jDeskWorkArea			"0,0,0,0"
*jDeskMButton1			[.none;!none;!Execute [!IrisCenter][!IrisPopup];!none]
*jDeskMButton2			[.none;!none;!IrisPopup;!none]
*jDeskMButton3			[.none;!none;!IrisCommandFocus;!none]

;set actions
*Alias				!IrisSpeakTime		!ParseEvars	!xSpeak "Current Time: %%[time]%%"
*Alias				!IrisSpeakDate		!ParseEvars	!xSpeak "The date is: %%[date('dddd d')]%%"
*Alias				!IrisSpeakBattery	!ParseEvars	!xSpeak "Remaining charge: %%[battery]%%"
*Alias				!IrisMoveEverything	!ParseEvars	!Execute [!CommandMove %%#IrisCurrentX%%# %%#IrisCurrentY%%#][!xTaskbarMove %%#IrisCurrentX%%# %%#IrisCurrentY%%#]
*Alias				!IrisSetQuickLaunch	!Execute	[!ComDlgFile !xTextSaveEvar @$ThemeDir$res\values\paths.rc@ @%1@ @^@fp^@][!Refresh]
*Alias				!IrisSetQuickLaunchDrop	!ParseEvars	!Execute	[!xTextSaveEvar @$ThemeDir$res\values\paths.rc@ @%1@ @%%#IrisVarsDropPath%%#@][!Refresh]
*Alias				!IrisButtonShow		!Execute	[!LabelSetAlpha %1 255][!LabelShow %2]
*Alias				!IrisButtonHide		!Execute	[!LabelHide %2][!LabelSetAlpha %1 1]
*Alias				!IrisCenter		!ParseEvars	!MouseMove %%#IrisCurrentX+IrisWidth/2%%# %%#IrisCurrentY+IrisHeight/2%%#
*Alias				!IrisCommandFocus	!Execute	[!IrisCenter][!CommandFocus]
*Alias				!IrisPopup		!ParseEvars	!Popup %%#IrisCurrentX+IrisWidth/2%%# %%#IrisCurrentY+IrisHeight/2%%# topcenter


;create iris
*Label				Iris
IrisAddToGroup			UIris
IrisX				-$IrisWidth/2$c
IrisY				-$IrisHeight/2$c
IrisCurrentX			$IrisX$
IrisCurrentY			$Irisy$
IrisWidth			$128*UIMultiplier$
IrisHeight			$128*UIMultiplier$
IrisPaintingMode		.image
IrisImage			iris.png
IrisAlphaMap			true
IrisTrueTransparency		true
IrisBehindWindow		xLabel
IrisMoveable			true
IrisMoveModifierKey		.none
IrisOnEnter			!LabelAlwaysOnTop UIrisButtons

UIrisAlwaysOnTop		true
UIrisOnMiddleClick		!CommandFocus
IrisOnLeftClickDown		!IrisPopup
UIrisOnMove			!IrisMoveEverything
UIrisBehindWindow		#32770 ;doesn't work?e

UIrisButtonsAddToGroup		UIris
UIrisButtonsAlphaFade		true
;UIrisButtonsAlphaTransparency	1
UIrisButtonsWidth		$IrisWidth$
UIrisButtonsHeight		$IrisHeight$
UIrisButtonsX			$IrisX$
UIrisButtonsY			$IrisY$
UIrisButtonsPaintingMode	.image
UIrisButtonsAlphaMap		true
UIrisButtonsFontAlign		.center
UIrisButtonsFont		"Open Sans Light"
UIrisButtonsFontHeight		$IrisHeight/5$
UIrisButtonsFontColor		ecf0f1
UIrisButtonsFontSmoothing	true
UIrisButtonsFontVisible		false

UIrisNotifyAddToGroup		UIris
UIrisNotifyX			$IrisX$
UIrisNotifyY			$IrisY$
UIrisNotifyWidth		$IrisWidth$
UIrisNotifyHeight		$IrisHeight$
UIrisNotifyPaintingMode 	.image
UIrisNotifyAlphaMap		true

