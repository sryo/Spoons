xTaskbarMaxLines		2
xTaskbarShowText		false
xTaskbarDisplay			"flashing"
xTaskbarOnMiddleClickButton	.close
xTaskbarTrueTransparency	true
xTaskbarAlphaMap		true
xTaskbarOnIconAdd


