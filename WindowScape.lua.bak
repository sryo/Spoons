local cancelAnimation     = animation.cancelAnimation
local cancelAllAnimations = animation.cancelAllAnimations
local easeOutCubic        = animation.easeOutCubic
local lerp                = animation.lerp
local lerpColor           = animation.lerpColor

local outline             = require("WindowScape.outline")
-- outline.init called after getOutlineColorForWindow is defined

local snapshots           = require("WindowScape.snapshots")
-- snapshots.init called after all callback functions are defined

